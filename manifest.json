{
  "manifest_version": 3,
  "name": "YouTube封印タイマー",
  "version": "1.2.0",
  "description": "設定した期間、YouTubeへのアクセスをブロックし、封印記録をSupabaseに同期できます。",
  "permissions": ["storage", "webNavigation", "tabs", "alarms"],
  "host_permissions": ["https://htpjpdagmbkkoqotdgzt.supabase.co/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "YouTube封印タイマー" },
  "options_page": "options.html"
}